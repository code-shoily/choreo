```elixirsiren = Choreo.Lab.Siren.new(buggy
  |> FSM.to_mermaid())
graphviz = buggy
  |> FSM.to_dot()
  |> Kino.VizJS.render(height: "600px")
sketch = Choreo.Lab.Sketch.new(buggy
